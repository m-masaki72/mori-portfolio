---
import Layout from "@/layouts/Layout.astro";
import { SOCIALS } from "@/consts";

const links = SOCIALS.map((s) => ({ label: s.NAME, url: s.HREF }));
---

<Layout title="Links" description="MasakiMoriのSNS・ブログ・作品発表先（GitHub、X、Zenn、Qiita、SoundCloud、YouTubeなど）へのリンク集">
    <section class="container mx-auto px-6 pt-28 pb-24 md:pt-36">
        <p class="eyebrow mb-3">Links</p>
        <h1 class="heading text-4xl md:text-6xl mb-10">リンク</h1>
        <ul class="flex flex-col gap-4 max-w-2xl">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-baseline gap-6 border border-dashed border-secondary/30 rounded-lg px-6 py-4 hover:border-secondary transition-colors"
                        >
                            <span class="font-plex font-bold text-xl">
                                {link.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</Layout>
