---
import { SITE, PROJECTS } from "@/consts";
import { PERSON_ID, WEBSITE_ID, breadcrumb } from "@/lib/jsonld";
import { getProjects } from "@/lib/projects";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import ProjectImage from "@/components/ProjectImage.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
    const all = await getProjects();
    return all.map((project, i) => ({
        params: { id: project.id },
        props: {
            project,
            prev: all[i - 1],
            next: all[i + 1],
            related: all.filter((p) => p.id !== project.id && p.data.category === project.data.category).slice(0, 3),
        },
    }));
}

const { project, prev, next, related } = Astro.props;
const { title, description, image, category, platform, tech, liveUrl, githubUrl } = project.data;

const { Content } = await render(project);

const pageURL = new URL(`/projects/${project.id}/`, SITE.URL).href;
const imageURL = new URL(image.url, SITE.URL).href;
const relatedUrls = [...new Set([liveUrl, githubUrl].filter(Boolean))];

const jsonLd = [
    {
        "@type": "CreativeWork",
        "@id": `${pageURL}#work`,
        name: title,
        description,
        url: pageURL,
        image: imageURL,
        inLanguage: "ja",
        genre: category,
        keywords: tech.join(", "),
        author: { "@id": PERSON_ID },
        isPartOf: { "@id": WEBSITE_ID },
        ...(relatedUrls.length > 0 && { sameAs: relatedUrls }),
    },
    breadcrumb([
        { name: "ホーム", url: `${SITE.URL}/` },
        { name: PROJECTS.TITLE, url: `${SITE.URL}/projects/` },
        { name: title, url: pageURL },
    ]),
];
---

<Layout title={title} description={description} image={image.url} ogType="article" jsonLd={jsonLd}>
    <div class="container mx-auto px-6 pt-24 md:pt-28 pb-20">
        <nav aria-label="パンくずリスト" class="mb-8 text-sm text-secondary">
            <ol class="flex flex-wrap items-center gap-2">
                <li><a href="/" class="hover:text-foreground underline-offset-2 hover:underline">ホーム</a></li>
                <li aria-hidden="true">/</li>
                <li><a href="/projects" class="hover:text-foreground underline-offset-2 hover:underline">{PROJECTS.TITLE}</a></li>
                <li aria-hidden="true">/</li>
                <li aria-current="page" class="text-foreground font-medium">{title}</li>
            </ol>
        </nav>

        <header class="space-y-5 pb-8">
            <div class="flex flex-wrap gap-1.5">
                <span class="chip-accent">{category}</span>
                <span class="chip">{platform}</span>
            </div>
            <h1 class="heading text-4xl md:text-6xl">{title}</h1>
            <p class="max-w-3xl text-lg md:text-xl text-secondary leading-relaxed">{description}</p>
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                {
                    liveUrl && (
                        <a href={liveUrl} target="_blank" rel="noopener" class="btn-primary">
                            アプリを開く <span aria-hidden="true">↗</span>
                        </a>
                    )
                }
                {
                    githubUrl && (
                        <a href={githubUrl} target="_blank" rel="noopener" class="btn-dark">
                            ソースコード <span aria-hidden="true">↗</span>
                        </a>
                    )
                }
            </div>
        </header>

        <figure class="overflow-hidden rounded-3xl border border-black/10 bg-muted">
            <ProjectImage
                src={image.url}
                alt={image.alt}
                eager
                class="mx-auto w-full max-h-[70vh] object-contain"
            />
        </figure>

        <div class="mt-12 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-10 lg:gap-16">
            <article class="prose-body max-w-prose">
                <Content />
            </article>
            <aside class="lg:sticky lg:top-24 self-start rounded-3xl border border-black/10 bg-background p-6 space-y-5">
                <dl class="space-y-4 text-sm">
                    <div>
                        <dt class="eyebrow mb-1">カテゴリ</dt>
                        <dd>{category}</dd>
                    </div>
                    <div>
                        <dt class="eyebrow mb-1">プラットフォーム</dt>
                        <dd>{platform}</dd>
                    </div>
                    {
                        tech.length > 0 && (
                            <div>
                                <dt class="eyebrow mb-2">使用技術</dt>
                                <dd>
                                    <ul class="flex flex-wrap gap-1.5">
                                        {tech.map((t) => <li class="chip">{t}</li>)}
                                    </ul>
                                </dd>
                            </div>
                        )
                    }
                </dl>
                {
                    (liveUrl || githubUrl) && (
                        <div class="flex flex-col gap-2 border-t border-dashed border-black/15 pt-5">
                            {liveUrl && (
                                <a href={liveUrl} target="_blank" rel="noopener" class="underline underline-offset-2 text-primary-ink">
                                    アプリを開く ↗
                                </a>
                            )}
                            {githubUrl && (
                                <a href={githubUrl} target="_blank" rel="noopener" class="underline underline-offset-2 text-primary-ink">
                                    GitHub ↗
                                </a>
                            )}
                        </div>
                    )
                }
            </aside>
        </div>

        <nav aria-label="前後の制作物" class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-dashed border-secondary pt-8">
            {
                prev ? (
                    <a href={`/projects/${prev.id}`} class="rounded-2xl border border-black/10 p-5 hover:border-foreground transition">
                        <span class="eyebrow block mb-1">← 前の制作物</span>
                        <span class="heading text-lg">{prev.data.title}</span>
                    </a>
                ) : <span />
            }
            {
                next && (
                    <a href={`/projects/${next.id}`} class="rounded-2xl border border-black/10 p-5 text-right hover:border-foreground transition">
                        <span class="eyebrow block mb-1">次の制作物 →</span>
                        <span class="heading text-lg">{next.data.title}</span>
                    </a>
                )
            }
        </nav>

        {
            related.length > 0 && (
                <section class="mt-16">
                    <h2 class="heading text-2xl md:text-3xl mb-6">同じカテゴリの制作物</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {related.map((p) => <Card entry={p} />)}
                    </div>
                </section>
            )
        }
    </div>
</Layout>
