---
import ArticleItem from "./ArticleItem.astro";
import Marquee from "./Marquee.astro";
import { getArticles } from "@/lib/articles";

const all = await getArticles();
const latest = all.slice(0, 4);
---

{
    latest.length > 0 && (
        <section id="Articles" class="py-16 md:py-24">
            <Marquee text="articles" label="最新の記事" />
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    {latest.map((article) => <ArticleItem entry={article} />)}
                </div>
                <div class="mt-10 flex justify-center">
                    <a href="/articles" class="btn-ghost">
                        記事をすべて見る（{all.length}件） <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </section>
    )
}
