---
interface Props {
  text: string;
  // 見出しとして読み上げ・インデックスされるテキスト（装飾用 text とは別）
  label: string;
  duration?: string;
}

const { text, label, duration = "15s" } = Astro.props;
---

<h2 class="sr-only">{label}</h2>
<div class="overflow-hidden mb-12" aria-hidden="true">
  <div class="flex animate-scroll">
    {
      Array.from({ length: 2 }).map((_) => (
        <div class="flex shrink-0 whitespace-nowrap">
          {Array.from({ length: 10 }).map((_) => (
            <span class="heading text-5xl md:text-9xl uppercase mr-4 md:mr-8 -mb-2">
              {text}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style define:vars={{ duration }}>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll var(--duration) linear infinite;
  }
</style>
