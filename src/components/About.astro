---
type Props = {
    // 単体ページ（/about）では h1、トップでは h2
    as?: "h1" | "h2";
};

const { as: Heading = "h2" } = Astro.props;
const skills = ["C++", "C#", "JavaScript", "TypeScript", "JUCE", "Web Audio API", "Claude API", "Astro"];
---

<section id="About" class="container mx-auto px-6 py-16 md:py-24">
    <p class="eyebrow mb-3">About</p>
    <Heading class="heading text-4xl md:text-6xl mb-10 md:mb-14">自己紹介</Heading>
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-10 md:gap-16">
        <div class="overflow-hidden rounded-3xl border border-black/10 aspect-[668/516] max-w-[560px]">
            <img
                src="/portrait.jpg"
                alt="MasakiMori のプロフィール画像"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                width="668"
                height="516"
            />
        </div>

        <div class="space-y-8">
            <div class="text-lg md:text-xl text-secondary leading-relaxed space-y-4">
                <p>
                    MasakiMori です。音響・ゲーム・プラグイン開発が好きなエンジニアで、C++ を軸に VST
                    プラグインやゲーム、Web ツールなどジャンルを問わずものづくりを続けています。
                </p>
                <p>
                    最近は Claude API を使った作曲支援ツールや、インストール不要でブラウザだけで完結する小さなアプリづくりに力を入れています。
                </p>
            </div>
            <div>
                <h3 class="heading text-xl mb-4">スキル</h3>
                <ul class="flex flex-wrap gap-2.5">
                    {
                        skills.map((skill) => (
                            <li class="rounded-full border border-dashed border-secondary px-5 py-2 text-base">{skill}</li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
