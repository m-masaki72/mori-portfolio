---
import { webpOf } from "@/lib/projects";

type Props = {
    src: string;
    alt: string;
    class?: string;
    // ファーストビューの画像だけ eager にする
    eager?: boolean;
};

const { src, alt, class: className, eager = false } = Astro.props;
const webp = webpOf(src);
---

<picture>
    {webp && <source srcset={webp} type="image/webp" />}
    <img
        src={src}
        alt={alt}
        class={className}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
        width="1200"
        height="750"
    />
</picture>
