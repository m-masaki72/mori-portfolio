---
import Card from "./Card.astro";
import Marquee from "./Marquee.astro";
import { getProjects } from "@/lib/projects";

const all = await getProjects();
const featured = all.slice(0, 6);
---

<section id="Projects" class="py-16 md:py-24">
  <Marquee text="works" label="注目の制作物" />
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((project) => <Card entry={project} />)}
    </div>
    <div class="mt-10 flex justify-center">
      <a href="/projects" class="btn-ghost">
        制作物をすべて見る（{all.length}件） <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
