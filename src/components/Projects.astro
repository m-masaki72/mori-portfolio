---
import Card from "./Card.astro";
import Marquee from "./Marquee.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const allProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
).slice(0, 3);
---

<section id="Projects" class="container mx-auto px-6">
  <Marquee text="work" label="制作物" />
  {allProjects.map((project) => <Card entry={project} />)}
  <a href="/projects" class="inline-block mt-6 text-lg underline underline-offset-4">
    制作物をすべて見る →
  </a>
</section>
