---
import { SITE } from "@/consts";
import { CATEGORIES } from "@/content.config";
import { getProjects } from "@/lib/projects";
import ProjectImage from "./ProjectImage.astro";

const projects = await getProjects();
const featured = projects.slice(0, 3);
const counts = CATEGORIES.map((c) => ({
    name: c,
    count: projects.filter((p) => p.data.category === c).length,
})).filter((c) => c.count > 0);
---

<section class="container mx-auto px-6 pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] items-center gap-12 lg:gap-16">
        <div class="space-y-8">
            <p class="eyebrow">Indie Dev Lab by MasakiMori</p>
            <h1 class="heading text-[clamp(4rem,14vw,9rem)] leading-[0.9] uppercase">
                {SITE.TITLE}
            </h1>
            <p class="text-lg md:text-xl text-secondary max-w-xl leading-relaxed">
                音響・ゲーム・Webツールを中心に、思いついたものを形にしている個人開発ラボ。AI
                でコード進行を生み出す作曲ツールから、VST プラグイン、ブラウザだけで動く小さな便利アプリまで公開しています。
            </p>
            <ul class="flex flex-wrap gap-2" aria-label="カテゴリ別の制作物数">
                <li class="chip-accent">制作物 {projects.length}</li>
                {counts.map((c) => <li class="chip">{c.name} {c.count}</li>)}
            </ul>
            <div class="flex flex-col sm:flex-row gap-3">
                <a class="btn-primary" href="/projects">制作物を見る <span aria-hidden="true">→</span></a>
                <a class="btn-dark" href="/contact">お問い合わせ</a>
            </div>
        </div>

        <div class="relative hidden sm:block" aria-hidden="true">
            <div class="grid grid-cols-2 gap-4">
                {
                    featured.map((p, i) => (
                        <a
                            href={`/projects/${p.id}`}
                            tabindex="-1"
                            class:list={[
                                "block overflow-hidden rounded-2xl border border-black/10 bg-muted shadow-sm transition hover:-translate-y-1 hover:shadow-lg",
                                i === 0 && "col-span-2",
                            ]}
                        >
                            <ProjectImage
                                src={p.data.image.url}
                                alt=""
                                eager
                                class="w-full aspect-[1200/630] object-cover object-top"
                            />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>
