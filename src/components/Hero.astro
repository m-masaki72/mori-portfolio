---
import { SITE } from "@/consts";
import { getProjects, projectPath } from "@/lib/projects";
import { getArticles } from "@/lib/articles";
import ProjectImage from "./ProjectImage.astro";

const projects = await getProjects();
const articles = await getArticles();
const featured = projects.slice(0, 3);
---

<section class="container mx-auto px-6 pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] items-center gap-12 lg:gap-16">
        <div class="space-y-8">
            <p class="eyebrow">Dev Blog by MasakiMori</p>
            <h1 class="heading text-[clamp(4rem,14vw,9rem)] leading-[0.9] uppercase">
                {SITE.TITLE}
            </h1>
            <p class="text-lg md:text-xl text-secondary max-w-xl leading-relaxed">
                Claude Code を毎日の開発で使いながら、試したこと・測ったこと・失敗したことを書いている個人開発のブログ。音響・ゲーム・Webツールの制作物も公開しています。
            </p>
            <ul class="flex flex-wrap gap-2" aria-label="記事と制作物の数">
                <li class="chip-accent">記事 {articles.length}</li>
                <li class="chip">制作物 {projects.length}</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-3">
                <a class="btn-primary" href="/articles/">記事を読む <span aria-hidden="true">→</span></a>
                <a class="btn-dark" href="/projects/">制作物を見る</a>
            </div>
        </div>

        <div class="relative hidden sm:block" aria-hidden="true">
            <div class="grid grid-cols-2 gap-4">
                {
                    featured.map((p, i) => (
                        <a
                            href={projectPath(p.id)}
                            tabindex="-1"
                            class:list={[
                                "block overflow-hidden rounded-2xl border border-black/10 bg-muted shadow-sm transition hover:-translate-y-1 hover:shadow-lg",
                                i === 0 && "col-span-2",
                            ]}
                        >
                            <ProjectImage
                                src={p.data.image.url}
                                alt=""
                                eager
                                class="w-full aspect-[1200/630] object-cover object-top"
                            />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>
