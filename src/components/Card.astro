---
import type { Project } from "@/lib/projects";
import ProjectImage from "./ProjectImage.astro";

type Props = {
    entry: Project;
    eager?: boolean;
    headingLevel?: "h2" | "h3";
};

const { entry, eager = false, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, image, category, platform, tech } = entry.data;
---

<article
    data-category={category}
    class="group relative flex flex-col overflow-hidden rounded-3xl border border-black/10 bg-background transition hover:-translate-y-1 hover:shadow-[0_8px_0_0_var(--color-foreground)] hover:border-foreground focus-within:border-foreground"
>
    <div class="overflow-hidden bg-muted border-b border-black/10">
        <ProjectImage
            src={image.url}
            alt={image.alt}
            eager={eager}
            class="w-full aspect-[1200/630] object-cover object-top transition duration-500 group-hover:scale-[1.03]"
        />
    </div>
    <div class="flex flex-1 flex-col gap-3 p-5 md:p-6">
        <div class="flex flex-wrap gap-1.5">
            <span class="chip-accent">{category}</span>
            <span class="chip">{platform}</span>
        </div>
        <Heading class="heading text-xl md:text-2xl">
            <a href={`/projects/${entry.id}`} class="after:absolute after:inset-0 focus-visible:outline-none">
                {title}
            </a>
        </Heading>
        <p class="text-secondary leading-relaxed line-clamp-3">{description}</p>
        {
            tech.length > 0 && (
                <ul class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-2 font-plex text-xs text-secondary" aria-label="使用技術">
                    {tech.map((t) => <li>#{t}</li>)}
                </ul>
            )
        }
    </div>
</article>
