---
import { formatDate, isoDate, type Article } from "@/lib/articles";

type Props = {
    entry: Article;
    headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
---

<article
    data-tags={JSON.stringify(tags)}
    class="group relative rounded-3xl border border-black/10 bg-background p-5 md:p-6 transition hover:-translate-y-1 hover:shadow-[0_8px_0_0_var(--color-foreground)] hover:border-foreground focus-within:border-foreground"
>
    <time datetime={isoDate(pubDate)} class="text-sm text-secondary">{formatDate(pubDate)}</time>
    <Heading class="heading mt-1 text-xl md:text-2xl">
        <a href={`/articles/${entry.id}`} class="after:absolute after:inset-0 focus:outline-none">{title}</a>
    </Heading>
    <p class="mt-2 text-secondary leading-relaxed line-clamp-2">{description}</p>
    {
        tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
                {tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
        )
    }
</article>
