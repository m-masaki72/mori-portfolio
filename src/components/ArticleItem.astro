---
import { articlePath, formatDate, isoDate, type Article } from "@/lib/articles";
import TagList from "@/components/TagList.astro";

type Props = {
    entry: Article;
    headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
---

<article
    data-tags={JSON.stringify(tags)}
    class="group relative rounded-3xl border border-black/10 bg-background p-5 md:p-6 card-hover"
>
    <time datetime={isoDate(pubDate)} class="text-sm text-secondary">{formatDate(pubDate)}</time>
    <Heading class="heading mt-1 text-xl md:text-2xl">
        <a href={articlePath(entry.id)} class="after:absolute after:inset-0 focus:outline-none">{title}</a>
    </Heading>
    <p class="mt-2 text-secondary leading-relaxed line-clamp-2">{description}</p>
    <TagList tags={tags} class="mt-3" />
</article>
